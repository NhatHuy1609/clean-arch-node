{
  "name": "clean-arch-node",
  "version": "0.1.0",
  "private": true,
  "description": "Learning project: Clean Architecture + SOLID in Node.js/TypeScript, inspired by Practical.CleanArchitecture",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "arch": "depcruise src --config .dependency-cruiser.cjs",
    "verify": "npm run typecheck && npm run arch && npm run test",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "tsx --env-file-if-exists=.env src/infrastructure/persistence/postgres/migrate.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "dependency-cruiser": "^18.6.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "pg": "^8.23.1"
  }
}
